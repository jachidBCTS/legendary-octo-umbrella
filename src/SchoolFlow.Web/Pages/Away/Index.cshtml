@page "/Away"
@model SchoolFlow.Web.Pages.Away.IndexModel
@{
    ViewData["Title"] = "Away / stand-in";
}
<div class="page-head">
    <div><h1>Away / stand-in</h1><p class="sub" data-tip>Going to be out? Name someone who can approve in your place for those dates.</p></div>
</div>

<section class="panel">
    <h2>Add a stand-in</h2>
    <form method="post" asp-page-handler="Add" class="dept-form">
        <div><label class="lbl" for="to">Who can approve for you</label><input id="to" name="to" type="email" required placeholder="colleague@yourschool.org" autocomplete="off" data-people /></div>
        <div><label class="lbl" for="from-date">From</label><input id="from-date" name="startsOn" type="date" required value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div><label class="lbl" for="to-date">Until (inclusive)</label><input id="to-date" name="endsOn" type="date" required /></div>
        <div class="dept-save"><button class="btn primary">Save</button></div>
    </form>
    <p class="muted small" data-tip>While it is active, your stand-in is notified of approvals sent to you and can approve, reject or send them back. You can still decide them yourself.
        Each request's history shows who decided and that they were standing in for you. A stand-in is never asked to approve their own request.</p>
</section>

<h2 class="section-title">Your stand-ins</h2>
@if (Model.Mine.Count == 0) { <div class="empty small"><p>You have not named a stand-in.</p></div> }
else
{
    <div class="panel table-wrap"><table class="table stack">
        <thead><tr><th>Stand-in</th><th>From</th><th>Until</th><th>Status</th><th></th></tr></thead>
        <tbody>
        @foreach (var d in Model.Mine)
        {
            <tr>
                <td><strong>@d.ToEmail</strong></td>
                <td data-label="From">@d.StartsOn.ToString("MMM d, yyyy")</td>
                <td data-label="Until">@d.EndsOn.ToString("MMM d, yyyy")</td>
                <td data-label="Status"><span class="pill @(d.IsActiveOn(DateTime.Now) ? "ok" : "muted")">@(d.IsActiveOn(DateTime.Now) ? "Active now" : d.StartsOn.Date > DateTime.Now.Date ? "Upcoming" : "Ended")</span></td>
                <td><form method="post" asp-page-handler="Remove"><input type="hidden" name="id" value="@d.Id" /><button class="btn small ghost-danger">Remove</button></form></td>
            </tr>
        }
        </tbody>
    </table></div>
}

@if (Model.ForOthers.Count > 0)
{
    <h2 class="section-title">You are standing in for</h2>
    <div class="panel table-wrap"><table class="table stack">
        <thead><tr><th>Person</th><th>From</th><th>Until</th></tr></thead>
        <tbody>
        @foreach (var d in Model.ForOthers)
        {
            <tr><td><strong>@d.FromEmail</strong></td><td data-label="From">@d.StartsOn.ToString("MMM d, yyyy")</td><td data-label="Until">@d.EndsOn.ToString("MMM d, yyyy")</td></tr>
        }
        </tbody>
    </table></div>
}
