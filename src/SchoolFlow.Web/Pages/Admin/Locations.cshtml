@page
@model SchoolFlow.Web.Pages.Admin.LocationsModel
@{
    ViewData["Title"] = "Locations";
}
<div class="page-head">
    <div><h1>Locations</h1><p class="sub" data-tip>Buildings and rooms people can choose on forms with a Location field.</p></div>
    <div class="row wrap">
        @if (Model.SettingsLocations.Count > 0)
        {
            <form method="post" asp-page-handler="FromSettings"><button class="btn">Add the district's locations</button></form>
        }
        <form method="post" asp-page-handler="Sync"><button class="btn primary">Sync from Freshservice</button></form>
    </div>
</div>
<p class="muted" data-tip="page">Sync adds locations that are new in Freshservice, renames ones that changed, and switches off ones that were removed there.
    It never touches locations you added by hand and never switches one back on.
    @if (!Model.IsLive) { <strong>Freshservice is in simulation mode, so a sync brings in sample locations.</strong> }</p>

<section class="panel">
    <h2>Add a location by hand</h2>
    <form method="post" asp-page-handler="Add" class="row wrap">
        <input name="name" required maxlength="200" placeholder="e.g. Annex › Room 12" aria-label="Location name" />
        <button class="btn">Add location</button>
    </form>
</section>

@if (Model.Locations.Count == 0)
{
    <div class="empty small"><p>No locations yet. Sync from Freshservice or add one above.</p></div>
}
else
{
    <div class="panel table-wrap">
        <table class="table stack">
            <thead><tr><th>Location</th><th>District</th><th>Source</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var l in Model.Locations)
            {
                <tr class="@(l.IsActive ? "" : "row-off")">
                    <td>
                        <form method="post" asp-page-handler="Rename" class="row">
                            <input type="hidden" name="id" value="@l.Id" />
                            <input name="name" value="@l.Name" required maxlength="200" aria-label="Name" readonly="@(l.FreshserviceId != null)" />
                            @if (l.FreshserviceId == null) { <button class="btn small">Rename</button> }
                        </form>
                    </td>
                    <td data-label="District">
                        <form method="post" asp-page-handler="District" class="row">
                            <input type="hidden" name="id" value="@l.Id" />
                            @if (Model.DistrictChoices.Count > 0)
                            {
                                <select name="district" aria-label="District of @l.Name" data-autosubmit>
                                    <option value="" selected="@string.IsNullOrEmpty(l.District)">—</option>
                                    @foreach (var d in Model.DistrictChoices) { <option value="@d" selected="@string.Equals(d, l.District, StringComparison.OrdinalIgnoreCase)">@d</option> }
                                </select>
                            }
                            else
                            {
                                <input name="district" value="@l.District" maxlength="40" aria-label="District of @l.Name" placeholder="e.g. BCTS" class="district-input" />
                                <button class="btn small">Set</button>
                            }
                        </form>
                    </td>
                    <td class="muted" data-label="Source">@(l.FreshserviceId is long fs ? $"Freshservice #{fs}" : "Added by hand")</td>
                    <td data-label="Status"><span class="pill @(l.IsActive ? "ok" : "muted")">@(l.IsActive ? "Active" : "Off")</span></td>
                    <td>
                        <form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@l.Id" />
                            <button class="btn small">@(l.IsActive ? "Switch off" : "Switch on")</button></form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<p class="muted small" data-tip="page">Locations from Freshservice are renamed there, not here. A switched-off location is no longer offered on forms; requests that already used it keep it. The district decides which locations a Location field limited to one district offers; "Add the district's locations" fills it in from the staff list for locations that have none.</p>
