@page
@model SchoolFlow.Web.Pages.Admin.LocationsModel
@{
    ViewData["Title"] = "Locations";
}
<div class="page-head">
    <div><h1>Locations</h1><p class="sub" data-tip>Buildings and rooms people can choose on forms with a Location field.</p></div>
    <div class="row wrap">
        @if (Model.SettingsLocations.Count > 0)
        {
            <form method="post" asp-page-handler="FromSettings"><button class="btn">Add the district's locations</button></form>
        }
        <form method="post" asp-page-handler="Sync"><button class="btn primary">Sync from Freshservice</button></form>
    </div>
</div>
<p class="muted" data-tip="page">Sync adds locations that are new in Freshservice, renames ones that changed, and switches off ones that were removed there.
    It never touches locations you added by hand and never switches one back on.
    @if (!Model.IsLive) { <strong>Freshservice is in simulation mode, so a sync brings in sample locations.</strong> }</p>

<section class="panel">
    <h2>Add a location by hand</h2>
    <form method="post" asp-page-handler="Add" class="row wrap">
        <input name="name" required maxlength="200" placeholder="e.g. Annex › Room 12" aria-label="Location name" />
        <button class="btn">Add location</button>
    </form>
</section>

@if (Model.Locations.Count == 0)
{
    <div class="empty small"><p>No locations yet. Sync from Freshservice or add one above.</p></div>
}
else
{
    <form method="post" asp-page-handler="Save" data-batch>
    <div class="panel table-wrap">
        <table class="table stack">
            <thead><tr><th>Location</th><th>District</th><th>Source</th><th>On forms</th></tr></thead>
            <tbody>
            @for (var i = 0; i < Model.Locations.Count; i++)
            {
                var l = Model.Locations[i];
                <tr class="@(l.IsActive ? "" : "row-off")" data-batch-row>
                    <td>
                        @* Wrapped in a div, and marked for password managers to ignore: an extension's icon placed beside
                           a bare input in a table cell can become a cell of its own and push the row out of line. *@
                        <div class="cell-box">
                            <input type="hidden" name="Rows[@i].Id" value="@l.Id" />
                            @if (l.FreshserviceId == null)
                            {
                                <input name="Rows[@i].Name" value="@l.Name" required maxlength="200" aria-label="Name" autocomplete="off" data-lpignore="true" data-1p-ignore data-bwignore />
                            }
                            else
                            {
                                <input value="@l.Name" aria-label="Name (renamed in Freshservice)" readonly autocomplete="off" data-lpignore="true" data-1p-ignore data-bwignore />
                            }
                        </div>
                    </td>
                    <td data-label="District">
                        @if (Model.DistrictChoices.Count > 0)
                        {
                            <select name="Rows[@i].District" aria-label="District of @l.Name">
                                <option value="" selected="@string.IsNullOrEmpty(l.District)">—</option>
                                @foreach (var d in Model.DistrictChoices) { <option value="@d" selected="@string.Equals(d, l.District, StringComparison.OrdinalIgnoreCase)">@d</option> }
                            </select>
                        }
                        else
                        {
                            <input name="Rows[@i].District" value="@l.District" maxlength="40" aria-label="District of @l.Name" placeholder="e.g. BCTS" class="district-input" autocomplete="off" data-lpignore="true" data-1p-ignore data-bwignore />
                        }
                    </td>
                    <td class="muted" data-label="Source">@(l.FreshserviceId is long fs ? $"Freshservice #{fs}" : "Added by hand")</td>
                    <td data-label="On forms">
                        <label class="check-inline"><input type="checkbox" name="Rows[@i].Active" value="true" checked="@l.IsActive" data-row-on /> <span>@(l.IsActive ? "Offered" : "Off")</span></label>
                        <input type="hidden" name="Rows[@i].Active" value="false" />
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <div class="save-bar" data-batch-bar>
        <span class="save-bar-text" aria-live="polite">No unsaved changes</span>
        <button type="reset" class="btn" data-batch-undo disabled>Undo changes</button>
        <button class="btn primary" data-batch-save disabled>Save changes</button>
    </div>
    </form>
}
<p class="muted small" data-tip="page">Locations from Freshservice are renamed there, not here. Change as many rows as you like, then press Save changes once. A location that is not ticked under "On forms" is no longer offered on forms; requests that already used it keep it. The district decides which locations a Location field limited to one district offers; "Add the district's locations" fills it in from the staff list for locations that have none.</p>
