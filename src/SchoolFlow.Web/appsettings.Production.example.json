{
  "//": "Copy this file to appsettings.Production.json in the site folder ON THE SERVER and fill it in. Never commit the real file. Remove this comment line if you like; it is ignored.",

  "Auth": {
    "Mode": "EntraId",
    "Admins": [ "your.name@yourschool.org" ],
    "AllowedDomains": [ "yourschool.org" ]
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "00000000-0000-0000-0000-000000000000",
    "ClientId": "00000000-0000-0000-0000-000000000000",
    "ClientSecret": "paste-the-client-secret-value-here",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=YOUR-SQL-SERVER;Database=SchoolFlow;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=SchoolFlow"
  },
  "Freshservice": {
    "Domain": "yourschool",
    "ApiKey": "paste-the-freshservice-api-key-here",
    "WebhookSecret": "make-up-a-long-random-string-of-at-least-16-characters"
  },
  "Students": {
    "ConnectionString": "Server=YOUR-SQL-SERVER;Database=ThingsOfBergen;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=Bergen Forms",
    "View": "dbo.ActiveStudents",
    "Columns": { "StudentId": "StudentNumber", "School": "Location", "Academy": "Academy or Major", "District": "District" },
    "Match": {
      "Districts": { "BCTS": "the same district as ActiveStudents writes it" },
      "Locations": { "staff list location": "the same location as ActiveStudents writes it" }
    }
  },
  "Staff": {
    "View": "dbo.ActiveStaff"
  },
  "Gsa": {
    "ApiKey": "paste-the-api.data.gov-key-for-GSA-per-diem-here"
  },
  "Email": {
    "Mode": "Off",
    "From": "no-reply@yourschool.org",
    "BaseUrl": "https://schoolflow.yourschool.org"
  }
}
